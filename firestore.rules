rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents: users can only read and write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny all other unmatched document reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
