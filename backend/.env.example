# Firebase Web API Key (from Firebase Console -> Project Settings -> General)
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here

# Frontend URL for CORS (comma-separated if multiple, e.g. https://your-app.web.app)
FRONTEND_URL=http://127.0.0.1:5500,http://localhost:5500

# Environment mode: development | production
ENVIRONMENT=development

# (Optional for platforms like Render) Full service account JSON string OR path to key file
# FIREBASE_ADMIN_CREDENTIALS={"type": "service_account", ...}
# FIREBASE_CREDENTIALS_PATH=./firebase-admin-key.json
